DATABASE_URL=postgresql+psycopg://username:password@hostname/sessionsentinel
SESSION_HOURS=8
R1_HIGH_FAILS=5
R1_CRITICAL_FAILS=10
R1_WINDOW_SECONDS=120
R1_LOCK_SECONDS=1800
R6_ACCOUNT_THRESHOLD=3
R6_IP_THROTTLE_SECONDS=900

MAILJET_API_KEY=your_mailjet_public_api_key
MAILJET_API_SECRET=your_mailjet_private_api_secret
MAILJET_FROM_EMAIL=your-validated-sender@example.com
MAILJET_FROM_NAME=SessionSentinel
ADMIN_EMAIL=sessionsentinelserver@gmail.com
VERIFICATION_TTL_SECONDS=900
APP_BASE_URL=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174
